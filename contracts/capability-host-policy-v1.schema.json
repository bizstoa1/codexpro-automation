{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ventianima-lab.github.io/codex-web-gpt-automation/contracts/capability-host-policy-v1.schema.json",
  "title": "Capability host policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "max_web_multi_concurrency", "external_actions", "projects"],
  "properties": {
    "schema": {"const": "codex.chatgpt.capability-host-policy/v1"},
    "max_web_multi_concurrency": {"type": "integer", "minimum": 1, "maximum": 5},
    "external_actions": {"const": "deny"},
    "projects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["project_root", "profile_path", "profile_sha256", "pro", "oracle_read", "web_multi"],
        "properties": {
          "project_root": {"type": "string", "minLength": 1},
          "profile_path": {"type": "string", "minLength": 1},
          "profile_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "pro": {"type": "boolean"},
          "oracle_read": {"type": "boolean"},
          "web_multi": {"type": "boolean"}
        }
      }
    }
  }
}
